.phase3-panel {
    max-height: 95%;
}

.phase-toggle {
    min-height: 26px;
    margin-bottom: 3px;
    color: var(--text);
    font-size: 12px;
}

.phase-toggle .unity-toggle__checkmark {
    background-color: var(--track);
    border-width: 1px;
    border-color: var(--line);
}

.phase-toggle:checked .unity-toggle__checkmark {
    background-color: var(--accent);
    -unity-background-image-tint-color: rgb(4, 20, 27);
}

.phase-dropdown {
    margin-bottom: 8px;
    color: var(--text);
    background-color: var(--track);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
}

.phase-dropdown .unity-base-popup-field__text {
    color: var(--text);
}

.control-caption {
    margin-top: -2px;
    margin-bottom: 7px;
    color: var(--muted);
    font-size: 10px;
}

.inspection {
    margin-top: 8px;
    padding: 9px;
    color: rgb(188, 218, 229);
    background-color: rgba(35, 65, 82, 0.4);
    border-radius: 4px;
    font-size: 11px;
    white-space: normal;
}
