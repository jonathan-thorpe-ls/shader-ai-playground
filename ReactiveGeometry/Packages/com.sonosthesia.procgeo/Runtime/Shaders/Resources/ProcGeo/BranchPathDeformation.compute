#pragma kernel ClearBranchPath
#pragma kernel AddBranchTurbulence
#pragma kernel AddBranchAttractor
#pragma kernel ResolveBranchDepth
#pragma kernel SkinBranchGeometry
#pragma kernel RecomputeBranchNormals
#pragma kernel PublishBranchGeometry

struct BranchHeader
{
    uint sampleOffset;
    uint sampleCount;
    uint parentBranch;
    uint parentSample;
    uint generationDepth;
    uint terminal;
    float restLength;
    float initialRadius;
};

StructuredBuffer<BranchHeader> _BranchHeaders;
StructuredBuffer<float3> _RestPathPositions;
StructuredBuffer<float> _RestPathDistances;
StructuredBuffer<float3> _RestPathTangents;
StructuredBuffer<float3> _RestPathNormals;
StructuredBuffer<float3> _RestPathBinormals;
StructuredBuffer<float> _PathFlexibilities;
StructuredBuffer<float> _PathLocalPositions;
StructuredBuffer<float> _PathRadii;
StructuredBuffer<uint> _PathBranchIds;
RWStructuredBuffer<float3> _PathContributions;
RWStructuredBuffer<float3> _LivePathPositions;
RWStructuredBuffer<float3> _LivePathTangents;
RWStructuredBuffer<float3> _LivePathNormals;
RWStructuredBuffer<float3> _LivePathBinormals;

StructuredBuffer<uint> _VertexPathIndices;
StructuredBuffer<float> _SkinWeights;
StructuredBuffer<float3> _SkinOffsets;
RWStructuredBuffer<float3> _BasePositions;
RWStructuredBuffer<float3> _BaseNormals;
RWStructuredBuffer<float3> _BaseTangents;
RWStructuredBuffer<float3> _FinalPositions;
RWStructuredBuffer<float3> _FinalNormals;

ByteAddressBuffer _Indices;
StructuredBuffer<uint> _VertexFaceOffsets;
StructuredBuffer<uint> _VertexFaces;
RWByteAddressBuffer _DynamicVertices;
RWByteAddressBuffer _StaticVertices;

uint _BranchCount;
uint _PathSampleCount;
uint _VertexCount;
uint _TargetDepth;
float _Epsilon;
float _MaximumDisplacement;
float _Time;
float3 _WindDirection;
float _TurbulenceAmplitude;
float _TurbulenceFrequency;
float _TurbulenceSpeed;
float _TurbulencePhase;
int _TurbulenceSeed;
int _TurbulenceOctaves;
float _TurbulenceLacunarity;
float _TurbulenceGain;
float _AttractorStrength;
float3 _AttractorTarget;
float _AttractorPower;
float3 _SourceCenter;
float _InnerRadius;
float _OuterRadius;
float _SourceWeight;
int _FalloffMode;
int _SourceEnabled;

static const uint DYNAMIC_VERTEX_STRIDE = 24;
static const uint STATIC_VERTEX_STRIDE = 24;
static const uint NO_PARENT = 0xFFFFFFFF;

float3 SafeNormalize(float3 value, float3 fallback)
{
    return dot(value, value) > _Epsilon
        ? normalize(value)
        : fallback;
}

float SpatialFalloff(float distanceFromSource)
{
    if (_SourceEnabled == 0)
        return 1.0;
    if (distanceFromSource >= _OuterRadius)
        return 0.0;
    float t = saturate((distanceFromSource - _InnerRadius) /
        max(_OuterRadius - _InnerRadius, 1e-5));
    if (_FalloffMode == 0)
        return _SourceWeight;
    if (_FalloffMode == 1)
        return (1.0 - t) * _SourceWeight;
    return (1.0 - smoothstep(0.0, 1.0, t)) * _SourceWeight;
}

float2 Hash22(float2 value)
{
    float3 p = float3(
        value,
        dot(value, float2(127.1, 311.7)) + float(_TurbulenceSeed));
    p = frac(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return frac((p.xx + p.yz) * p.zy);
}

float ValueNoise(float2 value)
{
    float2 cell = floor(value);
    float2 local = frac(value);
    float2 weight = local * local * (3.0 - 2.0 * local);
    float a = dot(Hash22(cell), float2(0.754877666, 0.569840296));
    float b = dot(Hash22(cell + float2(1.0, 0.0)),
        float2(0.754877666, 0.569840296));
    float c = dot(Hash22(cell + float2(0.0, 1.0)),
        float2(0.754877666, 0.569840296));
    float d = dot(Hash22(cell + float2(1.0, 1.0)),
        float2(0.754877666, 0.569840296));
    return lerp(lerp(a, b, weight.x), lerp(c, d, weight.x), weight.y);
}

float TurbulenceNoise(float2 coordinate)
{
    float sum = 0.0;
    float normalizer = 0.0;
    float amplitude = 1.0;
    float frequency = 1.0;
    for (int octave = 0; octave < 6; octave++)
    {
        if (octave >= _TurbulenceOctaves)
            break;
        sum += (ValueNoise(coordinate * frequency) * 2.0 - 1.0) * amplitude;
        normalizer += amplitude;
        frequency *= _TurbulenceLacunarity;
        amplitude *= _TurbulenceGain;
    }
    return sum / max(normalizer, 0.0001);
}

[numthreads(64, 1, 1)]
void ClearBranchPath(uint3 dispatchId : SV_DispatchThreadID)
{
    uint sample = dispatchId.x;
    if (sample < _PathSampleCount)
        _PathContributions[sample] = 0.0;
}

[numthreads(64, 1, 1)]
void AddBranchTurbulence(uint3 dispatchId : SV_DispatchThreadID)
{
    uint sample = dispatchId.x;
    if (sample >= _PathSampleCount)
        return;
    BranchHeader branch = _BranchHeaders[_PathBranchIds[sample]];
    float localPhase = _PathLocalPositions[sample] *
        _TurbulenceFrequency * 6.28318530718;
    float time = _Time * _TurbulenceSpeed + _TurbulencePhase;
    float noise = TurbulenceNoise(float2(
        localPhase + time,
        float(_PathBranchIds[sample]) * 0.173 + time * 0.61803398875));
    float3 direction = _WindDirection -
        _RestPathTangents[sample] *
        dot(_WindDirection, _RestPathTangents[sample]);
    direction = SafeNormalize(
        direction, _RestPathNormals[sample]);
    float3 contribution = direction *
        (noise * _TurbulenceAmplitude * _PathFlexibilities[sample] *
        SpatialFalloff(distance(_RestPathPositions[sample], _SourceCenter)));
    if (sample == branch.sampleOffset)
        contribution = 0.0;
    _PathContributions[sample] += contribution;
}

[numthreads(64, 1, 1)]
void AddBranchAttractor(uint3 dispatchId : SV_DispatchThreadID)
{
    uint sample = dispatchId.x;
    if (sample >= _PathSampleCount)
        return;
    BranchHeader branch = _BranchHeaders[_PathBranchIds[sample]];
    float3 toTarget = _AttractorTarget - _RestPathPositions[sample];
    float3 direction = toTarget -
        _RestPathTangents[sample] *
        dot(toTarget, _RestPathTangents[sample]);
    float distanceFromTarget = length(direction);
    direction = SafeNormalize(direction, _RestPathNormals[sample]);
    float proximity = 1.0 - saturate(distanceFromTarget /
        max(length(_AttractorTarget - _RestPathPositions[
            branch.sampleOffset]), _Epsilon));
    float response = pow(saturate(
        0.25 + proximity * 0.75), max(_AttractorPower, 0.0001));
    float3 contribution = direction *
        (_AttractorStrength * response * _PathFlexibilities[sample] *
        SpatialFalloff(distance(_RestPathPositions[sample], _SourceCenter)));
    if (sample == branch.sampleOffset)
        contribution = 0.0;
    _PathContributions[sample] += contribution;
}

float3 TransformRestOffset(
    float3 offset,
    float3 restTangent,
    float3 restNormal,
    float3 restBinormal,
    float3 liveTangent,
    float3 liveNormal,
    float3 liveBinormal)
{
    return liveTangent * dot(offset, restTangent) +
        liveNormal * dot(offset, restNormal) +
        liveBinormal * dot(offset, restBinormal);
}

[numthreads(64, 1, 1)]
void ResolveBranchDepth(uint3 dispatchId : SV_DispatchThreadID)
{
    uint branchId = dispatchId.x;
    if (branchId >= _BranchCount)
        return;
    BranchHeader branch = _BranchHeaders[branchId];
    if (branch.generationDepth != _TargetDepth)
        return;
    uint start = branch.sampleOffset;
    uint end = start + branch.sampleCount;
    bool hasParent = branch.parentBranch != NO_PARENT;
    float3 attachmentPosition = 0.0;
    float3 attachmentRestTangent = 0.0;
    float3 attachmentRestNormal = 0.0;
    float3 attachmentRestBinormal = 0.0;
    float3 attachmentLiveTangent = 0.0;
    float3 attachmentLiveNormal = 0.0;
    float3 attachmentLiveBinormal = 0.0;
    if (hasParent)
    {
        attachmentPosition = _LivePathPositions[branch.parentSample];
        attachmentRestTangent = _RestPathTangents[branch.parentSample];
        attachmentRestNormal = _RestPathNormals[branch.parentSample];
        attachmentRestBinormal = _RestPathBinormals[branch.parentSample];
        attachmentLiveTangent = _LivePathTangents[branch.parentSample];
        attachmentLiveNormal = _LivePathNormals[branch.parentSample];
        attachmentLiveBinormal = _LivePathBinormals[branch.parentSample];
    }
    float3 restStart = _RestPathPositions[start];
    for (uint sample = start; sample < end; sample++)
    {
        float3 contribution = _PathContributions[sample];
        if (any(isnan(contribution)) || any(isinf(contribution)))
            contribution = 0.0;
        float contributionLength = length(contribution);
        if (contributionLength > _MaximumDisplacement)
            contribution = contribution *
                (_MaximumDisplacement / contributionLength);
        if (sample == start)
            contribution = 0.0;
        _PathContributions[sample] = contribution;
        if (hasParent)
        {
            float3 restOffset = _RestPathPositions[sample] - restStart;
            float3 hierarchyOffset = TransformRestOffset(
                restOffset,
                attachmentRestTangent,
                attachmentRestNormal,
                attachmentRestBinormal,
                attachmentLiveTangent,
                attachmentLiveNormal,
                attachmentLiveBinormal);
            _LivePathPositions[sample] =
                attachmentPosition + hierarchyOffset + contribution;
        }
        else
        {
            _LivePathPositions[sample] =
                _RestPathPositions[sample] + contribution;
        }
    }
    for (uint tangentIndex = start; tangentIndex < end; tangentIndex++)
    {
        uint previous = tangentIndex == start ? start : tangentIndex - 1;
        uint next = tangentIndex + 1 >= end ? end - 1 : tangentIndex + 1;
        float3 tangent = _LivePathPositions[next] -
            _LivePathPositions[previous];
        _LivePathTangents[tangentIndex] = SafeNormalize(
            tangent, _RestPathTangents[tangentIndex]);
    }
    float3 frameNormal = _RestPathNormals[start];
    if (hasParent)
    {
        frameNormal = TransformRestOffset(
            frameNormal,
            attachmentRestTangent,
            attachmentRestNormal,
            attachmentRestBinormal,
            attachmentLiveTangent,
            attachmentLiveNormal,
            attachmentLiveBinormal);
    }
    for (uint frameIndex = start; frameIndex < end; frameIndex++)
    {
        float3 tangent = _LivePathTangents[frameIndex];
        frameNormal = frameNormal - tangent * dot(frameNormal, tangent);
        frameNormal = SafeNormalize(frameNormal, _RestPathNormals[frameIndex]);
        float3 binormal = normalize(cross(tangent, frameNormal));
        _LivePathNormals[frameIndex] = frameNormal;
        _LivePathBinormals[frameIndex] = binormal;
    }
}

[numthreads(64, 1, 1)]
void SkinBranchGeometry(uint3 dispatchId : SV_DispatchThreadID)
{
    uint vertex = dispatchId.x;
    if (vertex >= _VertexCount)
        return;
    float3 position = 0.0;
    float3 radial = 0.0;
    float3 tangent = 0.0;
    for (uint influence = 0; influence < 4; influence++)
    {
        uint binding = vertex * 4 + influence;
        uint sample = _VertexPathIndices[binding];
        float3 offset = _SkinOffsets[binding];
        float3 samplePosition = _LivePathPositions[sample] +
            _LivePathTangents[sample] * offset.x +
            _LivePathNormals[sample] * offset.y +
            _LivePathBinormals[sample] * offset.z;
        float weight = _SkinWeights[binding];
        position += samplePosition * weight;
        radial += (
            _LivePathNormals[sample] * offset.y +
            _LivePathBinormals[sample] * offset.z) * weight;
        tangent += _LivePathTangents[sample] * weight;
    }
    _BasePositions[vertex] = position;
    _BaseNormals[vertex] = SafeNormalize(
        radial, float3(0.0, 1.0, 0.0));
    _BaseTangents[vertex] = SafeNormalize(
        tangent, float3(0.0, 1.0, 0.0));
}

[numthreads(64, 1, 1)]
void RecomputeBranchNormals(uint3 dispatchId : SV_DispatchThreadID)
{
    uint vertex = dispatchId.x;
    if (vertex >= _VertexCount)
        return;
    uint start = _VertexFaceOffsets[vertex];
    uint end = _VertexFaceOffsets[vertex + 1];
    float3 sum = 0.0;
    for (uint cursor = start; cursor < end; cursor++)
    {
        uint primitive = _VertexFaces[cursor];
        uint3 indices = _Indices.Load3(primitive * 12);
        float3 edgeA = _FinalPositions[indices.y] - _FinalPositions[indices.x];
        float3 edgeB = _FinalPositions[indices.z] - _FinalPositions[indices.x];
        float3 normal = cross(edgeA, edgeB);
        if (dot(normal, normal) > _Epsilon)
            sum += normal * rsqrt(dot(normal, normal));
    }
    _FinalNormals[vertex] = SafeNormalize(
        sum, _BaseNormals[vertex]);
}

[numthreads(64, 1, 1)]
void PublishBranchGeometry(uint3 dispatchId : SV_DispatchThreadID)
{
    uint vertex = dispatchId.x;
    if (vertex >= _VertexCount)
        return;
    uint dynamicOffset = vertex * DYNAMIC_VERTEX_STRIDE;
    _DynamicVertices.Store3(
        dynamicOffset, asuint(_BasePositions[vertex]));
    _DynamicVertices.Store3(
        dynamicOffset + 12, asuint(_FinalNormals[vertex]));
    uint staticOffset = vertex * STATIC_VERTEX_STRIDE;
    _StaticVertices.Store4(
        staticOffset, asuint(float4(_BaseTangents[vertex], 1.0)));
}
