#pragma kernel SpatialNoiseForce

RWStructuredBuffer<float3> _ForceBuffer;
StructuredBuffer<float3> _RestPositions;
StructuredBuffer<float3> _RestNormals;
StructuredBuffer<float> _DeformationWeights;

uint _VertexCount;
int _NoiseMode;
int _OutputMode;
int _Octaves;
int _Seed;
float _SpatialFrequency;
float3 _AxisScale;
float _NoiseTime;
float _Amplitude;
float _Lacunarity;
float _Gain;
float3 _SourceCenter;
float _InnerRadius;
float _OuterRadius;
float _SourceWeight;
int _FalloffMode;
int _SourceEnabled;
int _UseDeformationWeights;

float3 mod289(float3 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

float4 mod289(float4 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

float4 permute(float4 x)
{
    return mod289(((x * 34.0) + 1.0) * x);
}

float4 taylorInvSqrt(float4 r)
{
    return 1.79284291400159 - 0.85373472095314 * r;
}

float simplexNoise(float3 v)
{
    const float2 c = float2(1.0 / 6.0, 1.0 / 3.0);
    const float4 d = float4(0.0, 0.5, 1.0, 2.0);
    float3 i = floor(v + dot(v, c.yyy));
    float3 x0 = v - i + dot(i, c.xxx);
    float3 g = step(x0.yzx, x0.xyz);
    float3 l = 1.0 - g;
    float3 i1 = min(g.xyz, l.zxy);
    float3 i2 = max(g.xyz, l.zxy);
    float3 x1 = x0 - i1 + c.xxx;
    float3 x2 = x0 - i2 + c.yyy;
    float3 x3 = x0 - d.yyy;
    i = mod289(i);
    float seed = (float)(_Seed & 4095);
    float4 p = permute(permute(permute(
        i.z + float4(0.0, i1.z, i2.z, 1.0) + seed) +
        i.y + float4(0.0, i1.y, i2.y, 1.0)) +
        i.x + float4(0.0, i1.x, i2.x, 1.0));
    float n_ = 0.142857142857;
    float3 ns = n_ * d.wyz - d.xzx;
    float4 j = p - 49.0 * floor(p * ns.z * ns.z);
    float4 x_ = floor(j * ns.z);
    float4 y_ = floor(j - 7.0 * x_);
    float4 x = x_ * ns.x + ns.yyyy;
    float4 y = y_ * ns.x + ns.yyyy;
    float4 h = 1.0 - abs(x) - abs(y);
    float4 b0 = float4(x.xy, y.xy);
    float4 b1 = float4(x.zw, y.zw);
    float4 s0 = floor(b0) * 2.0 + 1.0;
    float4 s1 = floor(b1) * 2.0 + 1.0;
    float4 sh = -step(h, 0.0);
    float4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    float4 a1 = b1.xzyw + s1.xzyw * sh.zzww;
    float3 p0 = float3(a0.xy, h.x);
    float3 p1 = float3(a0.zw, h.y);
    float3 p2 = float3(a1.xy, h.z);
    float3 p3 = float3(a1.zw, h.w);
    float4 norm = taylorInvSqrt(float4(
        dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;
    float4 m = max(0.6 - float4(
        dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m *= m;
    return 42.0 * dot(m * m, float4(
        dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

float3 hash33(float3 p)
{
    p = float3(
        dot(p, float3(127.1, 311.7, 74.7)) + _Seed,
        dot(p, float3(269.5, 183.3, 246.1)) + _Seed,
        dot(p, float3(113.5, 271.9, 124.6)) + _Seed);
    return frac(sin(p) * 43758.5453123);
}

float2 voronoi(float3 x)
{
    float3 base = floor(x);
    float3 local = frac(x);
    float first = 8.0;
    float second = 8.0;
    [unroll]
    for (int z = -1; z <= 1; z++)
    [unroll]
    for (int y = -1; y <= 1; y++)
    [unroll]
    for (int xOffset = -1; xOffset <= 1; xOffset++)
    {
        float3 offset = float3(xOffset, y, z);
        float distance = length(offset + hash33(base + offset) - local);
        if (distance < first)
        {
            second = first;
            first = distance;
        }
        else if (distance < second)
        {
            second = distance;
        }
    }
    return float2(first, second - first);
}

float sampleNoise(float3 position)
{
    float sum = 0.0;
    float normalizer = 0.0;
    float amplitude = 1.0;
    float frequency = _SpatialFrequency;
    float3 movingPosition = position * _AxisScale;
    for (int octave = 0; octave < 6; octave++)
    {
        if (octave >= _Octaves)
            break;
        float3 samplePosition = movingPosition * frequency;
        samplePosition += float3(_NoiseTime, _NoiseTime * 0.731, -_NoiseTime * 0.419);
        float raw;
        if (_NoiseMode == 0)
            raw = 0.5 + 0.5 * clamp(simplexNoise(samplePosition), -1.0, 1.0);
        else
        {
            float2 cell = voronoi(samplePosition);
            raw = _NoiseMode == 1
                ? saturate(1.0 - cell.x / 1.7320508)
                : saturate(cell.y);
        }
        sum += raw * amplitude;
        normalizer += amplitude;
        frequency *= _Lacunarity;
        amplitude *= _Gain;
    }
    float normalized = sum / max(normalizer, 1e-5);
    if (_OutputMode == 0)
        return normalized * 2.0 - 1.0;
    if (_OutputMode == 2)
        return abs(normalized * 2.0 - 1.0);
    return normalized;
}

float spatialFalloff(float distanceFromSource)
{
    if (distanceFromSource >= _OuterRadius)
        return 0.0;
    float t = saturate((distanceFromSource - _InnerRadius) /
        max(_OuterRadius - _InnerRadius, 1e-5));
    if (_FalloffMode == 0)
        return 1.0;
    if (_FalloffMode == 1)
        return 1.0 - smoothstep(0.0, 1.0, t);
    return 1.0 - smoothstep(_InnerRadius, _OuterRadius, distanceFromSource);
}

[numthreads(64, 1, 1)]
void SpatialNoiseForce(uint3 id : SV_DispatchThreadID)
{
    uint vertex = id.x;
    if (vertex >= _VertexCount)
        return;
    if (!_SourceEnabled)
    {
        _ForceBuffer[vertex] = 0;
        return;
    }
    float3 rest = _RestPositions[vertex];
    float falloff = spatialFalloff(distance(rest, _SourceCenter));
    float weight = _UseDeformationWeights ? _DeformationWeights[vertex] : 1.0;
    _ForceBuffer[vertex] = _RestNormals[vertex] *
        (sampleNoise(rest) * _Amplitude * falloff * _SourceWeight * weight);
}
